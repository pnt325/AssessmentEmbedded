{
    "version": 8,
    "configurePresets": [
        {
            "name": "Default",
            "displayName": "GCC 15.2.0 x86_64-w64-mingw32 (ucrt64)",
            "description": "Using compilers: C = C:\\msys64\\ucrt64\\bin\\gcc.exe, CXX = C:\\msys64\\ucrt64\\bin\\g++.exe",
            "generator": "MinGW Makefiles",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "environment": {
                "PATH": "C:/msys64/ucrt64/bin;$penv{PATH}"
            },
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/gcc.exe",
                "CMAKE_MAKE_PROGRAM": "C:/msys64/ucrt64/bin/mingw32-make.exe",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "test",
            "configurePreset": "Default",
            "targets": ["run_tests"]
        }
    ],
    "workflowPresets": [
        {
            "name": "test",
            "displayName": "Configure, build and run tests",
            "steps": [
                { "type": "configure", "name": "Default" },
                { "type": "build", "name": "test" }
            ]
        }
    ]
}
